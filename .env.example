# Agency Operations Hub - copy to .env.local and fill in.
# Public (inlined into the browser bundle):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_DEMO_MODE=true

# Server-only secret (never prefix with NEXT_PUBLIC_). Leave empty for MOCK mode:
# notifications are recorded but nothing is sent. To send to your own test
# workspace, create an Incoming Webhook at https://api.slack.com/apps.
SLACK_WEBHOOK_URL=
